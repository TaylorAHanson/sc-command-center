# TODO pull from 
DATABRICKS_HOST=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
SQL_WAREHOUSE_ID=
DEV_MODE=true

# Which deployment this process is: local | dev | stage | prod. Reported by
# /api/health and used to badge the browser tab (prod is left unbadged). Only
# needed when serving the built bundle locally — `npm run dev` assumes "local".
APP_ENVIRONMENT=local

# Base URL of the external Supply Chain Agent service that powers the assistant
# panel. Locally the agent backend must run on a different port than this app
# (which uses 8000). In production, set this to the deployed agent App URL.
AGENT_BASE_URL=http://localhost:8001